# Server-only Supabase settings. Never commit the real service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Temporary fixed-admin login. Keep real values only in .env.local or Vercel.
ERP_ADMIN_USERNAME=
ERP_ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800

# Naver SearchAd read-only ingestion. Keep real values in Vercel only.
NAVER_SEARCHAD_ACCESS_LICENSE=
NAVER_SEARCHAD_SECRET_KEY=

# Required by the scheduled read-only job. Do not expose it to the browser.
CRON_SECRET=

# Optional internal low-balance email alert delivery (Resend HTTP API).
# Without these, the monitor still records screen warnings but does not email anyone.
RESEND_API_KEY=
BALANCE_ALERT_EMAIL_TO=
BALANCE_ALERT_EMAIL_FROM=
